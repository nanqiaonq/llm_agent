    "core": {
      "goal": "用一把判断的尺拆开任何 RAG/记忆系统的存储/检索/综合三层，判断 benchmark 诚不诚实、成本值不值",
      "target_slide_ids": ["S002", "S006", "S024"],
      "verify": "给学员一个陌生 RAG/记忆系统描述，能拆出其存储/检索/综合三层、指出 benchmark 口径是否可比、判断成本结构是否合理"
    },
    "sub": [
      { "goal": "区分编译式 RAG（编译成可读 wiki）vs 传统向量 RAG（机器黑箱索引）", "target_slide_ids": ["S002"] },
      { "goal": "解释 self-wiring 零 LLM 把 wikilink 织成 typed 图谱", "target_slide_ids": ["S008"] },
      { "goal": "说清 search 给页面 vs think 给答案+citation+gap", "target_slide_ids": ["S016", "S017"] },
      { "goal": "看懂两 benchmark 口径差异、严禁混引", "target_slide_ids": ["S021"] }
    ]
  },
