# ============================================================
# gstack-agent 配置文件（自动加载）
# ------------------------------------------------------------
# 此文件由 gstack_agent/config.py 自动读取（启动时一次）。
# 编辑此文件即可生效，**不需要修改代码**。
#
# 安全：此文件包含 API key，不要提交到 git。
# ============================================================


# ============================================================
# 1. API Keys（按 provider 配，至少配一个）
# ============================================================
# 默认 provider 是 deepseek，所以 DEEPSEEK_API_KEY 是必填。
# 切换其他 provider 时再填对应 key。

DEEPSEEK_API_KEY=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=


# ============================================================
# 2. Model 选择（不写就用 deepseek:deepseek-chat 默认）
# ============================================================
# spec 格式：provider:model
# 例如：
#   deepseek:deepseek-chat / deepseek:deepseek-reasoner
#   openai:gpt-5 / openai:gpt-4o
#   anthropic:claude-sonnet-4-6
#   openrouter:anthropic/claude-sonnet-4

# DeepSeek 子模型名（仅当 GSTACK_AGENT_MODEL 没设时生效）
# DEEPSEEK_MODEL=deepseek-chat

# 主代理完整 spec（设了会覆盖上面的 DEEPSEEK_MODEL 拼接）
# GSTACK_AGENT_MODEL=deepseek:deepseek-chat

# 子代理全局 fallback（不写则同主代理）
# GSTACK_AGENT_SUBAGENT_MODEL=deepseek:deepseek-chat

# 各子代理可独立指定（不写则 fallback 到 SUBAGENT_MODEL）
# 典型省钱套路：主代理用强模型 + 子代理用便宜模型
# GSTACK_AGENT_CEO_REVIEWER_MODEL=openai:gpt-5
# GSTACK_AGENT_ENG_REVIEWER_MODEL=anthropic:claude-sonnet-4-6
# GSTACK_AGENT_DESIGNER_MODEL=anthropic:claude-sonnet-4-6
# GSTACK_AGENT_DEBUGGER_MODEL=openai:gpt-5


# ============================================================
# 3. 行为开关
# ============================================================
# HITL 审批（1=开启，0=关闭仅 demo / 自动化测试用）
# GSTACK_AGENT_HITL=1

# Visualizer 实时打印（1=开启，0=关闭让输出更净）
# GSTACK_AGENT_VISUALIZER=1

# 工作区路径（agent 写文件落到这里）
# GSTACK_AGENT_WORKSPACE=~/gstack-agent-workspace


# ============================================================
# 4. LangSmith 追踪（可选）
# ============================================================
# 配了 KEY 自动启用，banner 会显示 "LangSmith on"
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=gstack-agent

# --- OpenRouter Claude Sonnet 4.6 (已切回 DeepSeek，需要时取消注释) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GSTACK_AGENT_MODEL=openrouter:anthropic/claude-sonnet-4-6
